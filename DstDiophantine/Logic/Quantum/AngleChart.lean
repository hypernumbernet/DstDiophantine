import DstDiophantine.Algebra.DualFourier
import DstDiophantine.Logic.Quantum.ChartOperators
import Mathlib.Analysis.Complex.RealDeriv
import Mathlib.Analysis.SpecialFunctions.ExpDeriv

/-!
# The discrete dual circle on one chart axis

An amplitude on `ℤ/Nℤ` assembles into a chart field: winding `k` is the
plane wave of momentum `k` along one axis, on a fixed carrier. At the `N`
points spaced by `2π/N`, that field returns the amplitude.

Translation by those spacings is the shift of the amplitude, on the whole
chart, and it is the evolution generated by the momentum. After `N` spacings
the displacement is `2π` and both the field and the amplitude stand where
they began.

A kick by an integer momentum multiplies the sampled amplitude by the
conjugate winding character. The phase that separates this kick from a
translation is that character. Off the samples, for `N > 1`, the kick of the
identity amplitude is not the field assembled from the clocked amplitude.
Multiplication by `e^{-i t x}` is the evolution generated by the coordinate.
At integer times it agrees with the character on the samples, and at time `N`
it returns the amplitude while multiplying the field by `e^{-i N x}`.
-/

namespace DstDiophantine

namespace Logic

open Complex DualFourier Finset

/-- Translation and a momentum kick differ by the phase `e^{i k·a}`, on every field. -/
theorem weyl_field (k a : Vec4) (Ψ : Vec4 → DiracSpinor) (x : Vec4) :
    chartTranslate a (momentumKick k Ψ) x =
      exp (I * (wavePhase k a : ℂ)) • momentumKick k (chartTranslate a Ψ) x := by
  unfold chartTranslate momentumKick
  rw [smul_smul, ← exp_add]
  have hphase : I * (wavePhase k (x + a) : ℂ) =
      I * (wavePhase k a : ℂ) + I * (wavePhase k x : ℂ) := by
    rw [wavePhase_add_right, ofReal_add, mul_add, add_comm]
  rw [hphase]

theorem wavePhase_smul_left (c : ℝ) (p x : Vec4) :
    wavePhase (c • p) x = c * wavePhase p x := by
  unfold wavePhase
  simp only [Pi.smul_apply, smul_eq_mul, Finset.mul_sum]
  refine Finset.sum_congr rfl fun μ _ => ?_
  ring

variable {N : ℕ} [NeZero N]

/-- Sample spacing `2π/N` along chart axis `μ`. -/
noncomputable def angleChartStep (N : ℕ) [NeZero N] (μ : Fin 4) : Vec4 :=
  ((2 * Real.pi) / (N : ℝ)) • Pi.single μ (1 : ℝ)

/-- Sample point of the site `j`, at spacing `2π/N`. -/
noncomputable def angleChartPoint (μ : Fin 4) (j : ZMod N) : Vec4 :=
  (j.val : ℝ) • angleChartStep N μ

/-- Integer momentum `k` along the same axis. -/
noncomputable def angleChartMomentum (μ : Fin 4) (k : ZMod N) : Vec4 :=
  (k.val : ℝ) • Pi.single μ (1 : ℝ)

/-- The point one half-step out along the axis, off the sample lattice when `N > 1`. -/
noncomputable def angleChartHalf (N : ℕ) [NeZero N] (μ : Fin 4) : Vec4 :=
  (Real.pi / (N : ℝ)) • Pi.single μ (1 : ℝ)

lemma angleChartPoint_nat {μ : Fin 4} {r : ℕ} (hr : r < N) :
    angleChartPoint μ (r : ZMod N) = (r : ℝ) • angleChartStep N μ := by
  unfold angleChartPoint
  rw [ZMod.val_natCast_of_lt hr]

lemma angleChartStep_period (μ : Fin 4) :
    (N : ℝ) • angleChartStep N μ = (2 * Real.pi) • Pi.single μ (1 : ℝ) := by
  unfold angleChartStep
  rw [smul_smul]
  have hN : (N : ℝ) ≠ 0 := by exact_mod_cast NeZero.ne N
  field_simp

lemma wavePhase_angleChart (μ : Fin 4) (k j : ZMod N) :
    wavePhase (angleChartMomentum μ k) (angleChartPoint μ j) =
      (2 * Real.pi * (k.val * j.val : ℕ)) / N := by
  have hpoint : angleChartPoint μ j =
      ((j.val : ℝ) * ((2 * Real.pi) / N)) • Pi.single μ (1 : ℝ) := by
    unfold angleChartPoint angleChartStep
    rw [smul_smul]
  rw [hpoint, wavePhase_smul_right]
  unfold angleChartMomentum
  rw [wavePhase_smul_left, wavePhase_single]
  simp only [Pi.single_eq_same]
  have hN : (N : ℝ) ≠ 0 := by exact_mod_cast NeZero.ne N
  field_simp
  push_cast
  ring

lemma exp_I_eq_expAngle (θ : ℝ) : exp (I * (θ : ℂ)) = expAngle θ := by
  unfold expAngle
  rw [mul_comm]

lemma angleChart_phase_star (μ : Fin 4) (k j : ZMod N) :
    exp (I * (wavePhase (angleChartMomentum μ k) (angleChartPoint μ j) : ℂ)) =
      star (dualCircleChar k j) := by
  rw [wavePhase_angleChart, exp_I_eq_expAngle, star_dualCircleChar]

lemma dualCircleChar_neg_left (r j : ZMod N) :
    dualCircleChar (-r) j = star (dualCircleChar r j) := by
  have hmul : dualCircleChar r j * dualCircleChar (-r) j = 1 := by
    rw [← dualCircleChar_add_left, add_neg_cancel, dualCircleChar_zero_left]
  have hstar : star (dualCircleChar r j) * dualCircleChar r j = 1 := by
    have hnorm : ‖dualCircleChar r j‖ ^ 2 = 1 := by rw [norm_dualCircleChar, one_pow]
    rw [star_def, ← normSq_eq_conj_mul_self, normSq_eq_norm_sq]
    exact_mod_cast hnorm
  rw [(inv_eq_of_mul_eq_one_right hmul).symm, (inv_eq_of_mul_eq_one_left hstar).symm]

lemma dualCircleChar_neg (k s : ZMod N) :
    dualCircleChar k (-s) = star (dualCircleChar k s) := by
  have hmul : dualCircleChar k s * dualCircleChar k (-s) = 1 := by
    rw [← dualCircleChar_add_right, add_neg_cancel, dualCircleChar_zero_right]
  have hstar : star (dualCircleChar k s) * dualCircleChar k s = 1 := by
    have hnorm : ‖dualCircleChar k s‖ ^ 2 = 1 := by rw [norm_dualCircleChar, one_pow]
    rw [star_def, ← normSq_eq_conj_mul_self, normSq_eq_norm_sq]
    exact_mod_cast hnorm
  have hneg : dualCircleChar k (-s) = (dualCircleChar k s)⁻¹ :=
    (inv_eq_of_mul_eq_one_right hmul).symm
  have hst : star (dualCircleChar k s) = (dualCircleChar k s)⁻¹ :=
    (inv_eq_of_mul_eq_one_left hstar).symm
  rw [hneg, hst]

/-- Chart field assembled from the winding transform of `f`, on the carrier `u`. -/
noncomputable def angleChartField (μ : Fin 4) (f : ZMod N → ℂ) (u : DiracSpinor) :
    Vec4 → DiracSpinor :=
  fun x =>
    ((N : ℂ)⁻¹ * ∑ k : ZMod N,
      dualCircleFourier f k *
        exp (I * (wavePhase (angleChartMomentum μ k) x : ℂ))) • u

theorem angleChartField_fourier_ext {μ : Fin 4} {f g : ZMod N → ℂ}
    (h : ∀ k, dualCircleFourier f k = dualCircleFourier g k) (u : DiracSpinor) :
    angleChartField μ f u = angleChartField μ g u := by
  funext x
  unfold angleChartField
  simp_rw [h]

/-- At every sample the assembled field is the amplitude on the carrier. -/
theorem angleChartField_sample (μ : Fin 4) (f : ZMod N → ℂ) (u : DiracSpinor) (j : ZMod N) :
    angleChartField μ f u (angleChartPoint μ j) = (f j) • u := by
  unfold angleChartField
  simp_rw [angleChart_phase_star μ]
  rw [← dualCircleFourier_inversion f j]

lemma chartTranslate_add (a b : Vec4) (Ψ : Vec4 → DiracSpinor) :
    chartTranslate (a + b) Ψ = chartTranslate a (chartTranslate b Ψ) := by
  funext x
  unfold chartTranslate
  rw [add_assoc]

lemma chartTranslate_zero (Ψ : Vec4 → DiracSpinor) : chartTranslate 0 Ψ = Ψ := by
  funext x
  simp [chartTranslate]

/-- Translation by `s` samples is the shift of the amplitude by `-s`, as chart fields. -/
theorem angleChartField_translate (μ : Fin 4) (s : ZMod N) (f : ZMod N → ℂ)
    (u : DiracSpinor) :
    chartTranslate (angleChartPoint μ s) (angleChartField μ f u) =
      angleChartField μ (dualCircleShift (-s) f) u := by
  funext x
  unfold chartTranslate angleChartField
  congr 1
  refine congrArg (fun z : ℂ => (N : ℂ)⁻¹ * z) ?_
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [wavePhase_add_right, ofReal_add, mul_add, exp_add, dualCircleFourier_shift,
    angleChart_phase_star, dualCircleChar_neg]
  ring

private lemma exp_I_nat_two_pi (n : ℕ) :
    exp (I * ((((n : ℝ) * (2 * Real.pi)) : ℝ) : ℂ)) = 1 := by
  have hcast : ((((n : ℝ) * (2 * Real.pi)) : ℝ) : ℂ) = (n : ℂ) * (2 * (Real.pi : ℂ)) := by
    push_cast
    ring
  rw [hcast, show I * ((n : ℂ) * (2 * (Real.pi : ℂ))) = (n : ℂ) * (2 * (Real.pi : ℂ) * I) by ring,
    exp_nat_mul, exp_two_pi_mul_I, one_pow]

lemma wavePhase_angleChart_period (μ : Fin 4) (k : ZMod N) :
    wavePhase (angleChartMomentum μ k) ((N : ℝ) • angleChartStep N μ) =
      (k.val : ℝ) * (2 * Real.pi) := by
  rw [angleChartStep_period, wavePhase_smul_right]
  unfold angleChartMomentum
  rw [wavePhase_smul_left, wavePhase_single]
  simp
  ring

/-- A displacement of one full period `2π` returns the assembled field. -/
theorem angleChartField_period (μ : Fin 4) (f : ZMod N → ℂ) (u : DiracSpinor) :
    chartTranslate ((N : ℝ) • angleChartStep N μ) (angleChartField μ f u) =
      angleChartField μ f u := by
  funext x
  unfold chartTranslate angleChartField
  congr 1
  refine congrArg (fun z : ℂ => (N : ℂ)⁻¹ * z) ?_
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [wavePhase_add_right, ofReal_add, mul_add, exp_add, wavePhase_angleChart_period,
    exp_I_nat_two_pi]
  ring

theorem angleChartField_period_nsmul (μ : Fin 4) (q : ℕ) (f : ZMod N → ℂ)
    (u : DiracSpinor) :
    chartTranslate ((q : ℝ) • ((N : ℝ) • angleChartStep N μ)) (angleChartField μ f u) =
      angleChartField μ f u := by
  induction q with
  | zero =>
      rw [Nat.cast_zero, zero_smul, chartTranslate_zero]
  | succ q ih =>
      have hstep : ((q + 1 : ℕ) : ℝ) • ((N : ℝ) • angleChartStep N μ) =
          (N : ℝ) • angleChartStep N μ + (q : ℝ) • ((N : ℝ) • angleChartStep N μ) := by
        rw [Nat.cast_succ, add_smul, one_smul, add_comm]
      rw [hstep, chartTranslate_add, ih, angleChartField_period]

private lemma step_split (μ : Fin 4) (q r : ℕ) :
    ((N * q + r : ℕ) : ℝ) • angleChartStep N μ =
      (r : ℝ) • angleChartStep N μ + (q : ℝ) • ((N : ℝ) • angleChartStep N μ) := by
  rw [Nat.cast_add, Nat.cast_mul, add_smul, mul_comm, mul_smul, add_comm]

/-- At every natural time, translation by that many spacings is the discrete shift. -/
theorem angleChartField_translate_nat (μ : Fin 4) (n : ℕ) (f : ZMod N → ℂ)
    (u : DiracSpinor) :
    chartTranslate ((n : ℝ) • angleChartStep N μ) (angleChartField μ f u) =
      angleChartField μ (dualCircleShift (-(n : ZMod N)) f) u := by
  set q := n / N
  set r := n % N
  have hn : n = N * q + r := (Nat.div_add_mod n N).symm
  have hr : r < N := Nat.mod_lt n (NeZero.pos N)
  have hNz : ((N : ℕ) : ZMod N) = 0 := by simp
  have hcast : (n : ZMod N) = (r : ZMod N) := by
    rw [hn, Nat.cast_add, Nat.cast_mul, hNz, zero_mul, zero_add]
  have hmod : ((N * q + r : ℕ) : ZMod N) = (r : ZMod N) := by
    rw [← hn, hcast]
  rw [hn, step_split, chartTranslate_add, angleChartField_period_nsmul,
    show (r : ℝ) • angleChartStep N μ = angleChartPoint μ (r : ZMod N) from
      (angleChartPoint_nat hr).symm,
    angleChartField_translate, hmod]

/-- A kick by momentum `r` multiplies the sampled amplitude by the character of `-r`. -/
theorem angleChartField_kick_sample (μ : Fin 4) (r : ZMod N) (f : ZMod N → ℂ)
    (u : DiracSpinor) (j : ZMod N) :
    momentumKick (angleChartMomentum μ r) (angleChartField μ f u) (angleChartPoint μ j) =
      (dualCircleClock (-r) f j) • u := by
  unfold momentumKick dualCircleClock
  rw [angleChartField_sample, angleChart_phase_star, smul_smul, dualCircleChar_neg_left, mul_comm]

/-- On the samples, the chart phase that separates a kick from a translation is
the conjugate character. -/
theorem angleChart_weyl_character (μ : Fin 4) (r s : ZMod N) (f : ZMod N → ℂ)
    (u : DiracSpinor) (j : ZMod N) :
    chartTranslate (angleChartPoint μ s)
        (momentumKick (angleChartMomentum μ r) (angleChartField μ f u)) (angleChartPoint μ j) =
      star (dualCircleChar r s) •
        momentumKick (angleChartMomentum μ r)
          (chartTranslate (angleChartPoint μ s) (angleChartField μ f u))
          (angleChartPoint μ j) := by
  rw [weyl_field, angleChart_phase_star]

private lemma sum_zmod_exp (θ : ℝ) :
    ∑ k : ZMod N, exp (I * ((k.val : ℝ) * θ : ℂ)) =
      ∑ n ∈ range N, exp (I * ((n : ℝ) * θ : ℂ)) := by
  symm
  refine sum_nbij' (fun n : ℕ => (n : ZMod N)) (fun j => j.val)
    (fun n hn => mem_univ _) (fun j _ => mem_range.mpr j.val_lt)
    (fun n hn => ZMod.val_natCast_of_lt (mem_range.mp hn))
    (fun j _ => ZMod.natCast_zmod_val j) ?_
  intro n hn
  rw [ZMod.val_natCast_of_lt (mem_range.mp hn)]

omit [NeZero N] in
private lemma exp_I_pi_div_ne_one (hN : 1 < N) :
    exp (I * ((Real.pi / N : ℝ) : ℂ)) ≠ 1 := by
  intro h
  rw [exp_eq_one_iff] at h
  obtain ⟨n, hn⟩ := h
  have hcoef : ((Real.pi / N : ℝ) : ℂ) = n * (2 * Real.pi) := by
    apply mul_right_cancel₀ I_ne_zero
    have hrew : I * ((Real.pi / N : ℝ) : ℂ) = n * (2 * (Real.pi : ℂ) * I) := by
      simpa [mul_assoc, mul_left_comm, mul_comm] using hn
    simpa [mul_assoc, mul_left_comm, mul_comm] using hrew
  have hreal : Real.pi / N = n * (2 * Real.pi) := by exact_mod_cast hcoef
  have hN0 : (N : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_zero_of_lt hN)
  have hdiv : (1 : ℝ) / N = n * 2 := by
    apply mul_left_cancel₀ Real.pi_ne_zero
    linear_combination hreal
  have h1 : (1 : ℝ) = n * 2 * N := by
    rw [div_eq_iff hN0] at hdiv
    linarith
  have hZ : (1 : ℤ) = n * 2 * (N : ℤ) := by exact_mod_cast h1
  have hN2 : (2 : ℤ) ≤ (N : ℤ) := by exact_mod_cast hN
  rcases lt_trichotomy n 0 with hnneg | hn0 | hnpos
  · have : n * 2 * (N : ℤ) < 0 := by nlinarith
    linarith
  · simp [hn0] at hZ
  · have : (4 : ℤ) ≤ n * 2 * (N : ℤ) := by nlinarith
    linarith

omit [NeZero N] in
private lemma exp_nat_I_pi_div (n : ℕ) :
    exp (I * (((n : ℝ) : ℂ) * ((Real.pi / N : ℝ) : ℂ))) =
      exp (I * ((Real.pi / N : ℝ) : ℂ)) ^ n := by
  rw [← exp_nat_mul]
  congr 1
  rw [← Complex.ofReal_natCast n]
  ring

omit [NeZero N] in
private lemma sum_exp_half (hN : 1 < N) :
    ∑ n ∈ range N, exp (I * (((n : ℝ) : ℂ) * ((Real.pi / N : ℝ) : ℂ))) =
      (exp (I * (Real.pi : ℂ)) - 1) /
        (exp (I * ((Real.pi / N : ℝ) : ℂ)) - 1) := by
  have hω : exp (I * ((Real.pi / N : ℝ) : ℂ)) ≠ 1 := exp_I_pi_div_ne_one hN
  simp_rw [exp_nat_I_pi_div]
  rw [geom_sum_eq hω]
  have hpow : exp (I * ((Real.pi / N : ℝ) : ℂ)) ^ N = exp (I * (Real.pi : ℂ)) := by
    rw [← exp_nat_mul]
    congr 1
    have hR : (N : ℝ) * (Real.pi / N) = Real.pi := by
      have hN0 : (N : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_zero_of_lt hN)
      field_simp
    have hmul : (N : ℂ) * ((Real.pi / N : ℝ) : ℂ) = (Real.pi : ℂ) := by
      calc
        (N : ℂ) * ((Real.pi / N : ℝ) : ℂ)
            = ((N : ℝ) : ℂ) * ((Real.pi / N : ℝ) : ℂ) := by norm_cast
        _ = (((N : ℝ) * (Real.pi / N) : ℝ) : ℂ) := by rw [← Complex.ofReal_mul]
        _ = (Real.pi : ℂ) := by rw [hR]
    calc
      (N : ℂ) * (I * ((Real.pi / N : ℝ) : ℂ))
          = I * ((N : ℂ) * ((Real.pi / N : ℝ) : ℂ)) := by ring
      _ = I * (Real.pi : ℂ) := by rw [hmul]
  rw [hpow]

private lemma angleChartField_half_scalar (hN : 1 < N) (μ : Fin 4) :
    (N : ℂ)⁻¹ * ∑ k : ZMod N,
        exp (I * (wavePhase (angleChartMomentum μ k) (angleChartHalf N μ) : ℂ)) ≠ 0 := by
  have hphase : ∀ k : ZMod N,
      wavePhase (angleChartMomentum μ k) (angleChartHalf N μ) =
        (k.val : ℝ) * (Real.pi / N) := by
    intro k
    change wavePhase ((k.val : ℝ) • Pi.single μ 1) ((Real.pi / N) • Pi.single μ 1) = _
    rw [wavePhase_smul_right, wavePhase_smul_left, wavePhase_single]
    simp [Pi.single_eq_same]
    ring_nf
  have hsum : ∑ k : ZMod N,
      exp (I * (wavePhase (angleChartMomentum μ k) (angleChartHalf N μ) : ℂ)) =
      ∑ k : ZMod N, exp (I * ((k.val : ℝ) * (Real.pi / N) : ℂ)) := by
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [hphase]
    simp only [Complex.ofReal_mul, Complex.ofReal_div, Complex.ofReal_natCast]
  rw [hsum]
  simp_rw [← Complex.ofReal_natCast, ← Complex.ofReal_div]
  rw [sum_zmod_exp (Real.pi / N), sum_exp_half hN]
  have hden : exp (I * ((Real.pi / N : ℝ) : ℂ)) - 1 ≠ 0 :=
    sub_ne_zero.mpr (exp_I_pi_div_ne_one hN)
  have hnum : (exp (I * (Real.pi : ℂ)) - 1 : ℂ) ≠ 0 := by
    rw [exp_I_pi]
    norm_num
  have hsum : (exp (I * (Real.pi : ℂ)) - 1) /
      (exp (I * ((Real.pi / N : ℝ) : ℂ)) - 1) ≠ 0 :=
    div_ne_zero hnum hden
  have hN0 : ((N : ℝ) : ℂ) ≠ 0 := by exact_mod_cast NeZero.ne N
  exact mul_ne_zero (inv_ne_zero hN0) hsum

private lemma angleChartField_half_ne_zero (hN : 1 < N) (μ : Fin 4) {u : DiracSpinor}
    (hu : u ≠ 0) :
    angleChartField μ (dualCircleDelta : ZMod N → ℂ) u (angleChartHalf N μ) ≠ 0 := by
  unfold angleChartField
  simp_rw [dualCircleFourier_delta, one_mul]
  intro h
  rcases smul_eq_zero.mp h with hs | hu0
  · exact angleChartField_half_scalar hN μ hs
  · exact hu hu0

omit [NeZero N] in
private lemma val_one (hN : 1 < N) : ((1 : ZMod N).val) = 1 := by
  rw [show (1 : ZMod N) = ((1 : ℕ) : ZMod N) by simp, ZMod.val_natCast,
    Nat.mod_eq_of_lt hN]

/-- For `N > 1` the kick by momentum `1` of the identity amplitude is not the
field assembled from the clocked amplitude. -/
theorem angleChartField_kick_ne_clock {μ : Fin 4} (hN : 1 < N) {u : DiracSpinor}
    (hu : u ≠ 0) :
    momentumKick (angleChartMomentum μ (1 : ZMod N))
        (angleChartField μ (dualCircleDelta : ZMod N → ℂ) u) ≠
      angleChartField μ (dualCircleClock (-(1 : ZMod N)) (dualCircleDelta : ZMod N → ℂ)) u := by
  have hclock : angleChartField μ (dualCircleClock (-(1 : ZMod N))
        (dualCircleDelta : ZMod N → ℂ)) u =
      angleChartField μ (dualCircleDelta : ZMod N → ℂ) u := by
    refine angleChartField_fourier_ext (fun k => ?_) u
    rw [dualCircleFourier_clock, dualCircleFourier_delta, dualCircleFourier_delta]
  rw [hclock]
  intro h
  have hpt := congr_fun h (angleChartHalf N μ)
  unfold momentumKick at hpt
  have hmom : angleChartMomentum μ (1 : ZMod N) = Pi.single μ (1 : ℝ) := by
    unfold angleChartMomentum
    rw [val_one hN]
    simp
  have hphase : wavePhase (Pi.single μ (1 : ℝ)) (angleChartHalf N μ) = Real.pi / N := by
    unfold angleChartHalf
    rw [wavePhase_smul_right, wavePhase_single]
    simp
  rw [hmom, hphase] at hpt
  have hne : exp (I * ((Real.pi / N : ℝ) : ℂ)) ≠ 1 := exp_I_pi_div_ne_one hN
  have hv : angleChartField μ (dualCircleDelta : ZMod N → ℂ) u (angleChartHalf N μ) ≠ 0 :=
    angleChartField_half_ne_zero hN μ hu
  apply hv
  have hdiff :
      (exp (I * ((Real.pi / N : ℝ) : ℂ)) - 1) •
        angleChartField μ (dualCircleDelta : ZMod N → ℂ) u (angleChartHalf N μ) = 0 := by
    rw [sub_smul, one_smul, sub_eq_zero.mpr hpt]
  rcases smul_eq_zero.mp hdiff with hs | hz
  · exact absurd (sub_eq_zero.mp hs) hne
  · exact hz

private lemma expAngle_winding_mod (n jv : ℕ) :
    expAngle (-(2 * Real.pi * ((n * jv : ℕ) : ℝ)) / N) =
      expAngle (-(2 * Real.pi * (((n % N) * jv : ℕ) : ℝ)) / N) := by
  set q := n / N
  set r := n % N
  have hn : n = N * q + r := (Nat.div_add_mod n N).symm
  have hprod : ((n * jv : ℕ) : ℝ) = (N : ℝ) * ((q * jv : ℕ) : ℝ) + ((r * jv : ℕ) : ℝ) := by
    exact_mod_cast (show n * jv = N * (q * jv) + r * jv by rw [hn]; ring)
  have hN0 : (N : ℝ) ≠ 0 := by exact_mod_cast NeZero.ne N
  have harg :
      -(2 * Real.pi * ((n * jv : ℕ) : ℝ)) / N =
        -(2 * Real.pi * ((r * jv : ℕ) : ℝ)) / N +
          ((-((q * jv : ℕ) : ℤ) : ℝ) * (2 * Real.pi)) := by
    rw [hprod]
    field_simp
    push_cast
    ring_nf
  rw [harg, expAngle_add]
  have hone : expAngle (((-((q * jv : ℕ) : ℤ) : ℝ) * (2 * Real.pi))) = 1 := by
    rw [expAngle_eq_one_iff]
    refine ⟨-((q * jv : ℕ) : ℤ), ?_⟩
    push_cast
    ring
  rw [hone, mul_one]

/-- At integer time `n`, multiplication by `e^{-i n x}` samples to the character of `n`. -/
theorem angleChartField_phase_sample (μ : Fin 4) (n : ℕ) (f : ZMod N → ℂ)
    (u : DiracSpinor) (j : ZMod N) :
    momentumKick ((-(n : ℝ)) • Pi.single μ (1 : ℝ)) (angleChartField μ f u)
        (angleChartPoint μ j) =
      (dualCircleClock (n : ZMod N) f j) • u := by
  unfold momentumKick dualCircleClock
  rw [angleChartField_sample, smul_smul]
  congr 1
  rw [wavePhase_smul_left]
  have hpt : wavePhase (Pi.single μ (1 : ℝ)) (angleChartPoint μ j) =
      (2 * Real.pi * j.val) / N := by
    unfold angleChartPoint angleChartStep
    rw [smul_smul, wavePhase_smul_right, wavePhase_single]
    simp [Pi.single_eq_same]
    have hN : (N : ℝ) ≠ 0 := by exact_mod_cast NeZero.ne N
    field_simp
  rw [hpt, exp_I_eq_expAngle]
  have harg : (-(n : ℝ)) * ((2 * Real.pi * j.val) / N) =
      -(2 * Real.pi * ((n * j.val : ℕ) : ℝ)) / N := by
    have hN : (N : ℝ) ≠ 0 := by exact_mod_cast NeZero.ne N
    field_simp
    push_cast
    ring_nf
  rw [harg, expAngle_winding_mod, dualCircleChar, ZMod.val_natCast]

/-- At time `N` the samples have returned the amplitude. -/
theorem angleChartField_phase_order_sample (μ : Fin 4) (f : ZMod N → ℂ)
    (u : DiracSpinor) (j : ZMod N) :
    momentumKick ((-(N : ℝ)) • Pi.single μ (1 : ℝ)) (angleChartField μ f u)
        (angleChartPoint μ j) =
      (f j) • u := by
  rw [angleChartField_phase_sample]
  have h0 : (N : ZMod N) = 0 := by simp
  rw [h0, dualCircleClock, dualCircleChar_zero_left, one_mul]

/-- At time `N` the same phase multiplies the field by `e^{-i N x}`, which does not
return the identity amplitude. -/
theorem angleChartField_phase_order_ne {μ : Fin 4} (hN : 1 < N) {u : DiracSpinor}
    (hu : u ≠ 0) :
    momentumKick ((-(N : ℝ)) • Pi.single μ (1 : ℝ))
        (angleChartField μ (dualCircleDelta : ZMod N → ℂ) u) ≠
      angleChartField μ (dualCircleDelta : ZMod N → ℂ) u := by
  intro h
  have hpt := congr_fun h (angleChartHalf N μ)
  unfold momentumKick at hpt
  rw [wavePhase_smul_left] at hpt
  have haxis : wavePhase (Pi.single μ (1 : ℝ)) (angleChartHalf N μ) = Real.pi / N := by
    unfold angleChartHalf
    rw [wavePhase_smul_right, wavePhase_single]
    simp
  rw [haxis] at hpt
  have hhalf : (-(N : ℝ)) * (Real.pi / N) = -Real.pi := by
    have hN0 : (N : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_zero_of_lt hN)
    field_simp
  rw [hhalf] at hpt
  have hphase : exp (I * Complex.ofReal (-Real.pi)) = -1 := by
    rw [Complex.ofReal_neg]
    rw [show I * (-(Real.pi : ℂ)) = -(I * (Real.pi : ℂ)) by ring, exp_neg, exp_I_pi]
    norm_num
  rw [hphase, neg_one_smul] at hpt
  have hv : angleChartField μ (dualCircleDelta : ZMod N → ℂ) u (angleChartHalf N μ) ≠ 0 :=
    angleChartField_half_ne_zero hN μ hu
  apply hv
  have htwo : (2 : ℂ) •
      angleChartField μ (dualCircleDelta : ZMod N → ℂ) u (angleChartHalf N μ) = 0 := by
    have hcancel := neg_add_cancel
      (angleChartField μ (dualCircleDelta : ZMod N → ℂ) u (angleChartHalf N μ))
    rw [hpt] at hcancel
    simpa [two_smul] using hcancel
  exact (smul_eq_zero.mp htwo).resolve_left (by norm_num)

lemma angleChartField_eq_sum (μ : Fin 4) (f : ZMod N → ℂ) (u : DiracSpinor) (x : Vec4) :
    angleChartField μ f u x =
      ∑ k : ZMod N, ((N : ℂ)⁻¹ * dualCircleFourier f k) •
        planeWave (angleChartMomentum μ k) u x := by
  unfold angleChartField planeWave
  rw [Finset.mul_sum, Finset.sum_smul]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [show (N : ℂ)⁻¹ * (dualCircleFourier f k *
        exp (I * (wavePhase (angleChartMomentum μ k) x : ℂ))) =
      ((N : ℂ)⁻¹ * dualCircleFourier f k) *
        exp (I * (wavePhase (angleChartMomentum μ k) x : ℂ)) by ring,
    ← smul_smul]

theorem differentiable_angleChartField (μ : Fin 4) (f : ZMod N → ℂ) (u : DiracSpinor) :
    Differentiable ℝ (angleChartField μ f u) := by
  have heq : angleChartField μ f u =
      ∑ k ∈ (Finset.univ : Finset (ZMod N)),
        fun x => ((N : ℂ)⁻¹ * dualCircleFourier f k) •
          planeWave (angleChartMomentum μ k) u x := by
    funext x
    rw [Finset.sum_apply]
    exact angleChartField_eq_sum μ f u x
  rw [heq]
  exact Differentiable.sum fun k _ =>
    (differentiable_planeWave (angleChartMomentum μ k) u).const_smul
      ((N : ℂ)⁻¹ * dualCircleFourier f k)

/-- Translation along the samples is the evolution generated by the momentum. -/
theorem angleChartField_translate_deriv (μ : Fin 4) (f : ZMod N → ℂ) (u : DiracSpinor)
    (x : Vec4) :
    deriv (fun t : ℝ => angleChartField μ f u (x + t • angleChartStep N μ)) 0 =
      I • ∑ ν : Fin 4, (angleChartStep N μ ν : ℂ) •
        momentumOp ν (angleChartField μ f u) x :=
  translate_deriv_momentum (differentiable_angleChartField μ f u x) (angleChartStep N μ)

/-- Multiplication by `e^{-i t x}` is the evolution generated by the coordinate. -/
theorem deriv_coordPhase (μ : Fin 4) (Ψ : Vec4 → DiracSpinor) (x : Vec4) :
    deriv (fun t : ℝ => momentumKick ((-t) • Pi.single μ (1 : ℝ)) Ψ x) 0 =
      (-I) • positionOp μ Ψ x := by
  unfold momentumKick positionOp
  have hphase : ∀ t : ℝ, wavePhase ((-t) • Pi.single μ (1 : ℝ)) x = -(t * x μ) := by
    intro t
    rw [wavePhase_smul_left]
    have hcomm : wavePhase (Pi.single μ (1 : ℝ)) x = wavePhase x (Pi.single μ (1 : ℝ)) := by
      unfold wavePhase
      refine Finset.sum_congr rfl fun ν _ => ?_
      ring
    rw [hcomm, wavePhase_single]
    ring
  simp_rw [hphase]
  have hlin := ((hasDerivAt_id (0 : ℝ)).mul_const (x μ)).neg
  simp only [id_eq, one_mul] at hlin
  have hexp := (hlin.ofReal_comp.const_mul I).cexp
  have hbody : ∀ t : ℝ, -(t * x μ) = (-(fun y : ℝ => y * x μ)) t := by
    intro t
    simp
  simp_rw [hbody]
  rw [deriv_smul_const hexp.differentiableAt (Ψ x), hexp.deriv]
  simp only [Pi.neg_apply]
  have hzero : -(0 * x μ) = 0 := by ring
  rw [hzero, Complex.ofReal_zero, mul_zero, Complex.exp_zero, one_mul]
  have hI : I * ((-x μ : ℝ) : ℂ) = (-I) * (x μ : ℂ) := by
    rw [Complex.ofReal_neg]
    ring
  rw [hI, mul_smul]

end Logic

end DstDiophantine
